# Copy to .env and fill in. Never commit .env.

# Postgres password used by docker-compose. It also appears in DATABASE_URL below,
# so change both together.
POSTGRES_PASSWORD=change-me
# SQLAlchemy async URL for the ledger database. Host `postgres` works inside Docker Compose;
# when running `uv run` on the Mac, use `localhost` instead.
DATABASE_URL=postgresql+asyncpg://lifeledger:change-me@postgres:5432/lifeledger
# Password for the read-only PostgreSQL role used by the FastMCP server
MCP_DB_PASSWORD=
# Read-only database connection URL for Claude Desktop / FastMCP server
MCP_DATABASE_URL=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram chat id; the bot answers only this chat
TELEGRAM_OWNER_CHAT_ID=

# Shared token the SMS forwarder sends with each webhook call
SMS_WEBHOOK_TOKEN=
# JSON list of allowlisted bank SMS sender headers (DLT), e.g. ["HDFCBK","SBIUPI"]
TRUSTED_SMS_HEADERS=[]
# JSON list of allowlisted bank email domains, e.g. ["hdfcbank.net"]
TRUSTED_EMAIL_DOMAINS=[]
# JSON list of your names, removed before any cloud model call
OWNER_NAMES=[]

# Ollama OpenAI-compatible endpoint (Ollama runs natively on the Mac)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Local model name served by Ollama
LOCAL_MODEL=
# Set true to allow masked text to go to the cloud model
ALLOW_CLOUD_LLM=false
# Anthropic API key (only used when ALLOW_CLOUD_LLM=true)
ANTHROPIC_API_KEY=
# Cloud model used as the last resort
CLOUD_MODEL=claude-haiku-5-5
# Minimum category confidence before asking you
CATEGORY_CONFIDENCE_THRESHOLD=0.8

# Langfuse tracing & observability (optional - disabled if keys are not set)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://host.docker.internal:3000

# Timezone for dates shown to you and schedules
TIMEZONE=Asia/Kolkata
# Folder where raw emails are dropped for the parser sandbox
INBOX_DIR=/data/inbox
# Folder where the sandbox writes parse results
OUTBOX_DIR=/data/outbox
# Passwords to try when decrypting password-protected PDF bills
PDF_PASSWORDS='["password123"]'

# Gmail label that selects the emails to fetch
GMAIL_LABEL=LifeLedger
# Days of history to fetch on the first run
GMAIL_BACKFILL_DAYS=30
# Seconds between Gmail polls
GMAIL_POLL_SECONDS=120
# Google Calendar ID for renewal tracking (optional)
RENEWALS_CALENDAR_ID=
# Google OAuth client file (git-ignored secrets/ folder)
GOOGLE_CREDENTIALS_PATH=secrets/credentials.json
# Google OAuth token file (git-ignored secrets/ folder)
GOOGLE_TOKEN_PATH=secrets/token.json
# Largest raw email accepted, in bytes
MAX_EMAIL_BYTES=10000000
# Days to keep raw inbox and outbox files
RAW_RETENTION_DAYS=30

# Temporal server address for bill reminder workflows and worker
TEMPORAL_ADDRESS=temporal:7233

# Morning briefing hour in local time (0-23, default 8 = 8 AM)
BRIEFING_HOUR_LOCAL=8
# Set true to send an ElevenLabs audio note alongside the morning briefing text
# WARNING: sending a voice briefing transmits your briefing text to ElevenLabs' API
BRIEFING_VOICE=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
